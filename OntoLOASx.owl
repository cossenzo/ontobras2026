<?xml version="1.0"?>
<rdf:RDF xmlns="http://ontoloasx.org/ontoloasx#"
     xml:base="http://ontoloasx.org/ontoloasx"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:gufo="http://purl.org/nemo/gufo#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://ontoloasx.org/ontoloasx">
        <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://ontoloasx.org/ontoloasx#addresses -->

    <owl:ObjectProperty rdf:about="http://ontoloasx.org/ontoloasx#addresses">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontoloasx.org/ontoloasx#Solution"/>
        <rdfs:range rdf:resource="http://ontoloasx.org/ontoloasx#Problem"/>
        <rdfs:label xml:lang="en">addresses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ontoloasx.org/ontoloasx#appliesTo -->

    <owl:ObjectProperty rdf:about="http://ontoloasx.org/ontoloasx#appliesTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontoloasx.org/ontoloasx#Solution"/>
        <rdfs:range rdf:resource="http://ontoloasx.org/ontoloasx#Context"/>
        <rdfs:label xml:lang="en">appliesTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ontoloasx.org/ontoloasx#hasElement -->

    <owl:ObjectProperty rdf:about="http://ontoloasx.org/ontoloasx#hasElement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontoloasx.org/ontoloasx#Solution"/>
        <rdfs:range rdf:resource="http://ontoloasx.org/ontoloasx#SolutionElement"/>
        <rdfs:label xml:lang="en">hasElement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ontoloasx.org/ontoloasx#hasLimitation -->

    <owl:ObjectProperty rdf:about="http://ontoloasx.org/ontoloasx#hasLimitation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontoloasx.org/ontoloasx#Solution"/>
        <rdfs:range rdf:resource="http://ontoloasx.org/ontoloasx#Limitation"/>
        <rdfs:label xml:lang="en">hasLimitation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ontoloasx.org/ontoloasx#hasObjective -->

    <owl:ObjectProperty rdf:about="http://ontoloasx.org/ontoloasx#hasObjective">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontoloasx.org/ontoloasx#Study"/>
        <rdfs:range rdf:resource="http://ontoloasx.org/ontoloasx#Objective"/>
        <rdfs:label xml:lang="en">hasObjective</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ontoloasx.org/ontoloasx#identifies -->

    <owl:ObjectProperty rdf:about="http://ontoloasx.org/ontoloasx#identifies">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontoloasx.org/ontoloasx#Study"/>
        <rdfs:range rdf:resource="http://ontoloasx.org/ontoloasx#ResearchGap"/>
        <rdfs:label xml:lang="en">identifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ontoloasx.org/ontoloasx#investigates -->

    <owl:ObjectProperty rdf:about="http://ontoloasx.org/ontoloasx#investigates">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontoloasx.org/ontoloasx#ResearchQuestion"/>
        <rdfs:range rdf:resource="http://ontoloasx.org/ontoloasx#Problem"/>
        <rdfs:label xml:lang="en">investigates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ontoloasx.org/ontoloasx#proposes -->

    <owl:ObjectProperty rdf:about="http://ontoloasx.org/ontoloasx#proposes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontoloasx.org/ontoloasx#Study"/>
        <rdfs:range rdf:resource="http://ontoloasx.org/ontoloasx#Solution"/>
        <rdfs:label xml:lang="en">proposes</rdfs:label>
    </owl:ObjectProperty>
    


