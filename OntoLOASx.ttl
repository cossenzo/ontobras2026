@prefix : <http://ontoloasx.org/ontoloasx#>.
@prefix gufo: <http://purl.org/nemo/gufo#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<http://ontoloasx.org/ontoloasx> rdf:type owl:Ontology;
    owl:imports gufo:.
:ResearchGap rdf:type owl:Class, gufo:SituationType, owl:NamedIndividual;
    rdfs:subClassOf gufo:Situation;
    rdfs:label "ResearchGap"@en.
:Problem rdf:type owl:Class, gufo:SituationType, owl:NamedIndividual;
    rdfs:subClassOf gufo:Situation;
    rdfs:label "Problem"@en.
:ResearchQuestion rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "ResearchQuestion"@en.
:Limitation rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:IntrinsicMode;
    rdfs:label "Limitation"@en.
:Study rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Study"@en.
:Objective rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:IntrinsicMode;
    rdfs:label "Objective"@en.
:Context rdf:type owl:Class, gufo:SituationType, owl:NamedIndividual;
    rdfs:subClassOf gufo:Situation;
    rdfs:label "Context"@en.
:Solution rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Solution"@en.
:SolutionElement rdf:type owl:Class, gufo:Category, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "SolutionElement"@en.
<researchGap:description> rdfs:domain :ResearchGap;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "description"@en.
<problem:description> rdfs:domain :Problem;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "description"@en.
<researchQuestion:description> rdfs:domain :ResearchQuestion;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "description"@en.
<limitation:description> rdfs:domain :Limitation;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "description"@en.
<limitation:addedInReview> rdfs:domain :Limitation;
    rdfs:range xsd:boolean;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "addedInReview"@en.
<study:title> rdfs:domain :Study;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "title"@en.
<objective:description> rdfs:domain :Objective;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "description"@en.
<context:description> rdfs:domain :Context;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "description"@en.
<solutionElement:description> rdfs:domain :SolutionElement;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "description"@en.
<solutionElement:isOriginal> rdfs:domain :SolutionElement;
    rdfs:range xsd:boolean;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "isOriginal"@en.
<solutionElement:isQuantitative> rdfs:domain :SolutionElement;
    rdfs:range xsd:boolean;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "isQuantitative"@en.
<solutionElement:number> rdfs:domain :SolutionElement;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "number"@en.
:investigates rdf:type owl:ObjectProperty;
    rdfs:domain :ResearchQuestion;
    rdfs:range :Problem;
    rdfs:label "investigates"@en.
:proposes rdf:type owl:ObjectProperty;
    rdfs:domain :Study;
    rdfs:range :Solution;
    rdfs:label "proposes"@en.
:addresses rdf:type owl:ObjectProperty;
    rdfs:domain :Solution;
    rdfs:range :Problem;
    rdfs:label "addresses"@en.
:appliesTo rdf:type owl:ObjectProperty;
    rdfs:domain :Solution;
    rdfs:range :Context;
    rdfs:label "appliesTo"@en.
:hasObjective rdf:type owl:ObjectProperty;
    rdfs:domain :Study;
    rdfs:range :Objective;
    rdfs:label "hasObjective"@en.
:identifies rdf:type owl:ObjectProperty;
    rdfs:domain :Study;
    rdfs:range :ResearchGap;
    rdfs:label "identifies"@en.
:hasLimitation rdf:type owl:ObjectProperty;
    rdfs:domain :Solution;
    rdfs:range :Limitation;
    rdfs:label "hasLimitation"@en.
:hasElement rdf:type owl:ObjectProperty;
    rdfs:domain :Solution;
    rdfs:range :SolutionElement;
    rdfs:label "hasElement"@en.
